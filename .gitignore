# Test output and generated artifacts
tests/results/
tests/outputs/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Logs (application-generated records, not source)
*.log
logs/

# OS / editor noise
.DS_Store
*.swp
*~

# Office lock files (the report is edited as .docx)
~$*
.~lock.*#

# Scratch buffer (CLAUDE.md exempts tmp*.md from the no-root-md rule)
tmp*.md

# Timestamped host-side telemetry captures
tmp/telemetry/*
!tmp/telemetry/.gitkeep

# Runtime tunnel caches (not source)
scripts/.sky-ollama-port
scripts/.rh-tunnel.pid
